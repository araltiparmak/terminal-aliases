# Define base directories
DEV_FOLDER="dev"
REPO_NAME="terminal-aliases"
REPO_PATH="$HOME/$DEV_FOLDER/$REPO_NAME"

# general
alias a="open -e $REPO_PATH/aliases"
alias z="open -e ~/.zshrc"
alias d="cd ~/Desktop"
alias dd="cd ~/$DEV_FOLDER"
alias c="clear"
alias o="open ."
alias ..="cd .."
alias md="mkdir"

# claude
alias cc="claude"
alias cs="open -e ~/.claude/settings.json"

# git
alias add="git add ."
alias gi="git init"
alias gs="git status"
alias gf="git fetch"
alias gp="git pull"
alias gl="git clone"
alias gc="git commit"
alias gca="git commit --amend --no-edit"
alias gm="git fetch origin && git rebase origin/main"
alias gmm="git fetch origin && git merge --no-ff --no-commit origin/master"
alias gmn="git fetch origin && git merge --no-ff --no-commit origin/main"

# yarn
alias yi="yarn install"
alias yb="yarn build"
alias ys="yarn start"
alias yw="yarn web"
alias yt="yarn test"
alias yl="yarn lint"
alias yf="yarn format"

# npm
alias ni="npm i"
alias ns="npm run start"

# bun
alias bi="bun install"
alias bs="bun start"
alias bl="bun lint"
alias bf="bun format"

# pnpm
alias pi="pnpm install"
alias pd="pnpm dev"
alias pb="pnpm build"
alias pl="pnpm lint"
alias pf="pnpm format"

# terraform
alias ti="terraform init"
alias tp="terraform plan"
alias ta="terraform apply"
alias tf="terraform fmt -recursive"
alias tv="terraform validate"

# terragrunt
alias tg="terragrunt"
alias tgp="terragrunt plan"
alias tga="terragrunt apply"
alias tgf="terragrunt hcl fmt"
alias tgv="terragrunt validate"

# docker
alias di="docker images"
alias dr="docker run"
alias dp="docker ps"
alias dk="docker kill"
alias dka="docker ps -q | xargs -r docker kill"
alias dcb="docker compose build"
alias dcu="docker compose up"

# java
alias jv="java -version"

# gradle
alias gb="gradle build"
alias gbr="gradle bootRun"

update_aliases() {
    echo "Updating aliases from repository..."
    if git -C "$REPO_PATH" pull && source "$REPO_PATH/aliases"; then
        echo "✅ Aliases updated successfully!"
    else
        echo "❌ Alias update failed"
    fi
}

alias ua="update_aliases"

# make
alias mm="make"
alias ml="make lint-fix"
alias mb="make lint-fix build"
alias mt="make test"

# misc
alias bu='brew update && brew upgrade && brew autoremove && brew cleanup'

# react scaffold — scaffolds ~/dev/<name> (see scripts/cra.sh)
alias cra="$REPO_PATH/scripts/cra.sh"

mc() {
    mkdir -p -- "$1" && cd -- "$1"
}
